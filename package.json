{
  "name": "opencode-plugin-auto-update-improved",
  "version": "0.3.3",
  "description": "OpenCode plugin that auto-updates plugins in the background",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "auto-update",
    "dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/amit-batra/opencode-plugin-auto-update-improved.git"
  },
  "bugs": {
    "url": "https://github.com/amit-batra/opencode-plugin-auto-update-improved/issues"
  },
  "homepage": "https://github.com/amit-batra/opencode-plugin-auto-update-improved#readme",
  "author": "Amit Batra",
  "license": "MIT",
  "devDependencies": {
    "@types/bun": "^1.2.4",
    "@types/node": "^25.0.10",
    "tsup": "^8.3.6",
    "typescript": "^5.7.3"
  }
}
